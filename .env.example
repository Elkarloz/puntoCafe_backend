# MongoDB local. Cambia la URI si usas otro host o base de datos.
MONGODB_URI=mongodb://localhost:27017/cafeteria

# Puerto del API
PORT=3000

# Origen permitido por CORS (el dev server de Vite)
FRONTEND_ORIGIN=http://localhost:5173

# Secreto para firmar los JWT. Cámbialo antes de usar la app en serio.
JWT_SECRET=cambia-este-secreto

# Duración del token en segundos. 604800 = 7 días.
JWT_EXPIRES_IN=604800

# Usuario administrador que crea `npm run seed`
ADMIN_EMAIL=luzdary@gmail.com
ADMIN_PASSWORD=40769183
ADMIN_NOMBRE=Luz Dary
